// Manifesto PWA do totem
if (p === "/conversa/manifest.webmanifest") {
  return new Response(JSON.stringify({
    name: "ALMAFLUXO",
    short_name: "ALMAFLUXO",
    start_url: "/conversa/totem1",
    scope: "/conversa/",
    display: "fullscreen",
    orientation: "any",
    background_color: "#030508",
    theme_color: "#030508",
    icons: [{
      src: "/conversa/icon.svg",
      sizes: "any",
      type: "image/svg+xml"
    }]
  }), {
    status: 200,
    headers: {
      "Content-Type": "application/manifest+json; charset=utf-8",
      "Cache-Control": "no-cache",
      ...corsHeaders(origin)
    }
  });
}
