// Manifesto PWA original do ALMAFLUXO
if (p === "/conversa/manifest.webmanifest") {
  const manifesto = await fetch(
    INSTALADOR_BASE + "manifest.webmanifest",
    { cf: { cacheTtl: 0 } }
  );

  if (!manifesto.ok) {
    return new Response(
      "Manifesto não encontrado no repositório: " + manifesto.status,
      { status: 502 }
    );
  }

  return new Response(manifesto.body, {
    status: 200,
    headers: {
      "Content-Type": "application/manifest+json; charset=utf-8",
      "Cache-Control": "no-cache",
      ...corsHeaders(origin)
    }
  });
}
